// Kozan ROI
var kozan_roi = ee.FeatureCollection('FAO/GAUL/2015/level2')
  .filter(ee.Filter.eq('ADM2_NAME', 'Kozan'))
  .geometry();

//Landsat Kozan LST
var landsat = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
  .merge(ee.ImageCollection('LANDSAT/LC09/C02/T1_L2'))
  .filterBounds(kozan_roi)
  .filterDate('2020-01-01', '2025-01-01')
  .filter(ee.Filter.lt('CLOUD_COVER', 20));
  
function processLandsat(image) {
  var qa = image.select('QA_PIXEL');
  var cloud_mask = qa.bitwiseAnd(1 << 3).eq(0)
    .and(qa.bitwiseAnd(1 << 4).eq(0));
  var lst = image.select('ST_B10')
    .multiply(0.00341802)
    .add(149.0)
    .subtract(273.15)
    .rename('LST_C')
    .updateMask(cloud_mask);
  return lst.copyProperties(image, ['system:time_start']);
}

var landsat_lst = landsat.map(processLandsat);
var landsat_mean = landsat_lst.mean().clip(kozan_roi);

// Load and filter by region, date and thermal bands of FIRMS
var firms = ee.ImageCollection('FIRMS')
  .filterBounds(kozan_roi)
  .filterDate('2020-01-01', '2025-01-01')
  .select('T21');

// Extract the fire pixel centers from each image
var fire_points = firms.map(function(image) {
  var fire_mask = image.gt(300).selfMask();
  var vectors = fire_mask.reduceToVectors({
    geometry: kozan_roi,
    scale: 1000,
    maxPixels: 1e9,
    bestEffort: true,
    geometryType: 'centroid'  // to reduce points count
  });
  return vectors.map(function(f) {
    return f.set('date', image.date().format('YYYY-MM-dd'))
             .set('fire_label', 1);
  });
}).flatten().limit(500);
print('Fire points:', fire_points.size());

// Adding LST values to points
var fire_with_lst = landsat_mean.reduceRegions({
  collection: fire_points,
  reducer: ee.Reducer.mean(),
  scale: 1000
}).map(function(f) {
  return ee.Feature(null, {
    'LST_C': f.get('mean'),
    'date':  f.get('date'),
    'fire_label': 1
  });
});

// Random non-fire points
var non_fire_points = landsat_mean.sample({
  region: kozan_roi,
  scale: 1000,
  numPixels: 500,
  seed: 42,
  geometries: false
}).map(function(f) {
  return ee.Feature(null, {
    'LST_C': f.get('LST_C'),
    'date':  'no_fire',
    'fire_label': 0
  });
});

// Combine
var dataset = fire_with_lst.merge(non_fire_points);
print('Final dataset size:', dataset.size());
print('Sample:', dataset.first());

// Export to Drive
Export.table.toDrive({
  collection: dataset,
  description: 'Kozan_Fire_LST_Dataset',
  folder: 'GEE_LST_Exports',
  fileFormat: 'CSV'
});
